'use client';

import { useEffect, useMemo, useState } from 'react';
import { Download } from 'lucide-react';
import { PortalShell } from '@/app/components/PortalShell';

type ReportData = {
  activeSubscribers: number;
  activeTechnicians: number;
  openTickets: number;
  revenueCollected: number;
  pendingBills: number;
  totalBilled: number;
  billsByStatus: {
    paid: number;
    unpaid: number;
    overdue: number;
  };
  revenueTrend: Array<{ label: string; value: number }>;
};

const formatCurrency = (value: number) => `₱${value.toLocaleString()}`;

function getStatusTone(value: number, total: number) {
  if (total === 0) return 'bg-slate-200';
  if (value / total > 0.6) return 'bg-emerald-500';
  if (value / total > 0.3) return 'bg-blue-500';
  return 'bg-amber-500';
}

function ChartCard({ title, subtitle, children }: { title: string; subtitle: string; children: React.ReactNode }) {
  return <section className="rounded-xl border border-slate-200 bg-white p-6"><h2 className="font-bold">{title}</h2><p className="mt-1 text-sm text-slate-400">{subtitle}</p>{children}</section>;
}

export function AdminReportsPage() {
  const [report, setReport] = useState<ReportData | null>(null);

  useEffect(() => {
    fetch('/api/reports')
      .then(async (response) => {
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Unable to load reports.');
        setReport(result);
      })
      .catch(() => setReport(null));
  }, []);

  const statCards = useMemo(() => {
    if (!report) {
      return [
        ['TOTAL REVENUE', '₱0', 'Awaiting data'],
        ['TOTAL BILLED', '₱0', 'Awaiting data'],
        ['PENDING BILLS', '0', 'Awaiting data'],
        ['ACTIVE SUBSCRIBERS', '0', 'Awaiting data'],
      ];
    }

    return [
      ['TOTAL REVENUE', formatCurrency(report.revenueCollected), `${report.billsByStatus.paid} paid bills`],
      ['TOTAL BILLED', formatCurrency(report.totalBilled), `${report.billsByStatus.unpaid + report.billsByStatus.overdue} unpaid/overdue`],
      ['PENDING BILLS', String(report.pendingBills), `${report.openTickets} open tickets`],
      ['ACTIVE SUBSCRIBERS', String(report.activeSubscribers), `${report.activeTechnicians} active technicians`],
    ];
  }, [report]);

  const revenueTrend = report?.revenueTrend ?? [];
  const billStatus = report?.billsByStatus ?? { paid: 0, unpaid: 0, overdue: 0 };
  const totalStatus = Object.values(billStatus).reduce((sum, value) => sum + value, 0);
  const maxRevenue = revenueTrend.length ? Math.max(...revenueTrend.map((item) => item.value), 1) : 1;

  return <PortalShell role="admin"><div className="flex flex-wrap items-end justify-between gap-4"><div><p className="text-xs font-bold uppercase tracking-[0.18em] text-[#3b4fd8]">Performance</p><h1 className="mt-2 text-2xl font-bold tracking-tight">Reports &amp; Analytics</h1><p className="mt-1 text-sm text-slate-500">Live system overview</p></div><button className="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50"><Download size={16} />Export Report</button></div><div className="mt-7 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">{statCards.map(([label, value, trend]) => <article className="rounded-xl border border-slate-200 bg-white px-6 py-5" key={label}><p className="text-xs font-bold tracking-wide text-slate-400">{label}</p><p className="mt-3 text-2xl font-bold text-slate-900">{value}</p><p className="mt-2 text-xs font-semibold text-emerald-600">{trend}</p></article>)}</div><div className="mt-7 grid gap-5 xl:grid-cols-[1.15fr_0.85fr]"><ChartCard title="Monthly Revenue" subtitle="Last 6 months"><div className="mt-7 flex h-56 items-end gap-3 border-b border-slate-100 px-3 sm:gap-6">{revenueTrend.length ? revenueTrend.map((entry) => <div className="flex h-full flex-1 flex-col items-center justify-end gap-2" key={entry.label}><div className="w-full max-w-10 rounded-t bg-[#2f67e8] transition-all hover:bg-[#1f54ca]" style={{ height: `${Math.max(14, (entry.value / maxRevenue) * 100)}%` }} title={`${entry.label}: ${formatCurrency(entry.value)}`} /><span className="text-xs text-slate-400">{entry.label}</span></div>) : <div className="flex h-full w-full items-center justify-center text-sm text-slate-400">No revenue data yet.</div>}</div></ChartCard><ChartCard title="Billing Status" subtitle="Current bill mix"><div className="mt-8 space-y-7">{Object.entries(billStatus).map(([name, count]) => { const label = name.charAt(0).toUpperCase() + name.slice(1); const percentage = totalStatus ? Math.round((count / totalStatus) * 100) : 0; return <div key={name}><div className="flex justify-between text-sm"><span className="font-medium text-slate-600">{label}</span><span className="font-semibold text-slate-800">{count} bills</span></div><div className="mt-2 h-2.5 overflow-hidden rounded-full bg-slate-100"><div className={`${getStatusTone(count, totalStatus)} h-full rounded-full`} style={{ width: `${percentage}%` }} /></div><div className="mt-1 text-right text-xs font-semibold text-slate-400">{percentage}%</div></div>; })}</div></ChartCard></div></PortalShell>;
}
